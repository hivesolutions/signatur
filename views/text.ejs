<!DOCTYPE html>
<html lang="en">
    <%- include("head"); -%>
    <body>
        <% if (text) { %>
            <div class="text">
                <% text.forEach(function(item){ %>
                    <span class="item" style="font-family: '<%= item[0] %>'"><% if (item[1] === " ") { %>&nbsp;<% } else { %><%= item[1] %><% } %></span>
                <% }); %>
            </div>
        <% } %>
    </body>
</html>
